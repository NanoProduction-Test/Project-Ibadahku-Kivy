<HomeScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: 120
            padding: [0, 10]
            canvas.before:
                Color:
                    rgba: app.warna_utama
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "IbadahKu"
                font_size: 26
                bold: True
                color: 1, 1, 1, 1
            Label:
                text: root.tanggal
                font_size: 13
                color: 0.88, 0.96, 0.91, 1
            Label:
                text: root.countdown
                font_size: 17
                bold: True
                color: 1, 0.95, 0.8, 1
        ScrollView:
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                GridLayout:
                    id: timeline
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 6
                    padding: [10, 10]
                Widget:
                    size_hint_y: None
                    height: 16
                Label:
                    text: "Ceklis Ibadah Hari Ini"
                    font_size: 20
                    bold: True
                    size_hint_y: None
                    height: 32
                    color: app.warna_teks
                Label:
                    text: root.teks_streak
                    font_size: 14
                    size_hint_y: None
                    height: 24
                    color: app.warna_utama
                GridLayout:
                    id: grid_ceklis
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 6
                    padding: [10, 0]
                Tombol:
                    text: "+ Tambah Item Ceklis"
                    gaya: "utama_muda"
                    gaya_teks: "teks"
                    size_hint_y: None
                    height: 44
                    font_size: 14
                    on_release: root.buka_popup_ceklis()
                Widget:
                    size_hint_y: None
                    height: 14
        Navigasi:

<KegiatanScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: 60
            padding: [15, 8]
            spacing: 10
            canvas.before:
                Color:
                    rgba: app.warna_utama
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "Kegiatanku"
                font_size: 22
                bold: True
                color: 1, 1, 1, 1
            Tombol:
                text: "+ Tambah"
                size_hint_x: 0.28
                font_size: 13
                on_release: root.manager.current = "tambah"
        ScrollView:
            GridLayout:
                id: daftar_kegiatan
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: 6
                padding: [10, 10]
        Navigasi:

<TambahScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: [20, 15]
        spacing: 10
        BoxLayout:
            size_hint_y: None
            height: 60
            canvas.before:
                Color:
                    rgba: app.warna_utama
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "Tambah Kegiatan"
                font_size: 22
                bold: True
                color: 1, 1, 1, 1
        Widget:
        Label:
            text: "Nama kegiatan"
            size_hint_y: None
            height: 26
            halign: "left"
            text_size: self.width, None
            color: app.warna_teks
        TextInput:
            id: inp_nama
            multiline: False
            size_hint_y: None
            height: 46
            hint_text: "contoh: Baca Qur'an 1 halaman"
        Label:
            text: "Jam (format 24 jam, contoh: 06:30)"
            size_hint_y: None
            height: 26
            halign: "left"
            text_size: self.width, None
            color: app.warna_teks
        TextInput:
            id: inp_jam
            multiline: False
            size_hint_y: None
            height: 46
            hint_text: "06:30"
        Label:
            text: "Hari"
            size_hint_y: None
            height: 26
            color: app.warna_teks
        Spinner:
            id: spin_hari
            text: "Setiap hari"
            values: "Setiap hari,Senin,Selasa,Rabu,Kamis,Jumat,Sabtu,Ahad"
        Label:
            text: "Kategori"
            size_hint_y: None
            height: 26
            color: app.warna_teks
        Spinner:
            id: spin_kategori
            text: "Ibadah"
            values: "Ibadah,Belajar,Lainnya"
        Label:
            id: lbl_pesan
            text: ""
            color: 0.85, 0.25, 0.25, 1
            size_hint_y: None
            height: 24
        Widget:
        BoxLayout:
            size_hint_y: None
            height: 52
            spacing: 10
            Tombol:
                text: "Batal"
                gaya: "netral"
                gaya_teks: "teks"
                on_release: root.manager.current = "kegiatan"
            Tombol:
                text: "Simpan"
                on_release: root.simpan()
        Widget:
        Navigasi:

<TimerScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: 60
            canvas.before:
                Color:
                    rgba: app.warna_utama
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "Timer Sesi Ibadah"
                font_size: 22
                bold: True
                color: 1, 1, 1, 1
        Widget:
        Label:
            text: root.waktu
            font_size: 64
            bold: True
            color: app.warna_teks
        ProgressBar:
            id: progres
            max: 1
            value: 0
            size_hint_y: None
            height: 18
        Widget:
        Label:
            text: "Durasi (menit)"
            size_hint_y: None
            height: 26
            color: app.warna_pudar
            font_size: 13
        Spinner:
            id: spin_durasi
            text: "15"
            values: "1,5,10,15,20,30,45,60"
            size_hint_y: None
            height: 48
        Widget:
        Label:
            text: root.status
            font_size: 15
            color: app.warna_utama
            size_hint_y: None
            height: 40
        BoxLayout:
            size_hint_y: None
            height: 52
            spacing: 10
            Tombol:
                text: "Mulai"
                on_release: root.mulai()
            Tombol:
                text: "Jeda"
                gaya: "netral"
                gaya_teks: "teks"
                on_release: root.jeda()
            Tombol:
                text: "Ulang"
                gaya: "netral"
                gaya_teks: "teks"
                on_release: root.ulang()
        Widget:
        Label:
            text: root.total_hari_ini
            font_size: 14
            color: app.warna_pudar
            size_hint_y: None
            height: 30
        Widget:
        Navigasi:

<TasbihScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: 60
            canvas.before:
                Color:
                    rgba: app.warna_utama
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "Tasbih Digital"
                font_size: 22
                bold: True
                color: 1, 1, 1, 1
        Widget:
        Label:
            text: "Dzikir"
            size_hint_y: None
            height: 24
            color: app.warna_pudar
            font_size: 13
        Spinner:
            id: spin_dzikir
            text: "Subhanallah"
            values: "Subhanallah,Alhamdulillah,Allahu Akbar,Astaghfirullah,La ilaha illallah"
            size_hint_y: None
            height: 44
        Label:
            text: "Target"
            size_hint_y: None
            height: 24
            color: app.warna_pudar
            font_size: 13
        Spinner:
            id: spin_target
            text: "33"
            values: "33,99,100,1000,Bebas"
            size_hint_y: None
            height: 44
            on_text: root.perbarui()
        Widget:
        Button:
            text: root.hitungan_label
            font_size: 72
            bold: True
            color: 1, 1, 1, 1
            background_normal: ""
            background_down: ""
            background_color: app.warna_utama
            size_hint_y: None
            height: 230
            on_press: root.tap()
        Label:
            text: root.progres_label
            font_size: 16
            color: app.warna_teks
            size_hint_y: None
            height: 30
        Widget:
        Tombol:
            text: "Ulang Hitungan Hari Ini"
            gaya: "netral"
            gaya_teks: "teks"
            size_hint_y: None
            height: 48
            font_size: 13
            on_release: root.ulang()
        Widget:
        Navigasi:

<StatistikScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: 60
            padding: [10, 0]
            canvas.before:
                Color:
                    rgba: app.warna_utama
                Rectangle:
                    pos: self.pos
                    size: self.size
            Tombol:
                text: "< Kembali"
                gaya: "aksen"
                gaya_teks: "teks"
                size_hint_x: 0.32
                font_size: 13
                on_release: root.manager.current = "pengaturan"
            Label:
                text: "Statistik"
                font_size: 22
                bold: True
                color: 1, 1, 1, 1
        ScrollView:
            GridLayout:
                id: grid_stat
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: 8
                padding: [12, 12]

<PengaturanScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: 60
            canvas.before:
                Color:
                    rgba: app.warna_utama
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "Lainnya"
                font_size: 22
                bold: True
                color: 1, 1, 1, 1
        ScrollView:
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [15, 15]
                spacing: 10
                Label:
                    text: "Kota jadwal sholat"
                    size_hint_y: None
                    height: 26
                    bold: True
                    color: app.warna_teks
                Spinner:
                    id: spin_kota
                    text: "Jakarta"
                    size_hint_y: None
                    height: 46
                Label:
                    text: "(kota lain: tambah di DAFTAR_KOTA, main.py)"
                    font_size: 12
                    italic: True
                    size_hint_y: None
                    height: 24
                    color: app.warna_pudar
                Tombol:
                    text: "Simpan Kota"
                    size_hint_y: None
                    height: 48
                    on_release: root.simpan_kota()
                Widget:
                    size_hint_y: None
                    height: 20
                Label:
                    text: "Mode Gelap"
                    size_hint_y: None
                    height: 26
                    bold: True
                    color: app.warna_teks
                BoxLayout:
                    size_hint_y: None
                    height: 60
                    spacing: 10
                    Label:
                        text: "Tampilan gelap (aktif setelah app dibuka ulang)"
                        font_size: 13
                        color: app.warna_pudar
                        text_size: self.width, None
                        halign: "left"
                        valign: "middle"
                    Switch:
                        id: sw_gelap
                        on_active: root.ubah_mode(self, self.active)
                Widget:
                    size_hint_y: None
                    height: 20
                Tombol:
                    text: "Lihat Statistik"
                    gaya: "utama_muda"
                    gaya_teks: "teks"
                    size_hint_y: None
                    height: 48
                    on_release: root.manager.current = "statistik"
                Label:
                    id: lbl_status
                    text: ""
                    color: app.warna_teks
                    font_size: 13
                    size_hint_y: None
                    height: 44
                Widget:
                    size_hint_y: None
                    height: 14
        Navigasi: