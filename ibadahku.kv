<HomeScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: 92
            padding: [0, 14]
            canvas.before:
                Color:
                    rgba: 0.13, 0.45, 0.36, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "IbadahKu"
                font_size: 30
                bold: True
                color: 1, 1, 1, 1
            Label:
                text: root.tanggal
                font_size: 14
                color: 0.88, 0.96, 0.91, 1
        ScrollView:
            GridLayout:
                id: timeline
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: 6
                padding: [10, 10]
        Navigasi:

<KegiatanScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: 60
            padding: [15, 8]
            spacing: 10
            canvas.before:
                Color:
                    rgba: 0.13, 0.45, 0.36, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "Kegiatanku"
                font_size: 22
                bold: True
                color: 1, 1, 1, 1
            Button:
                text: "+ Tambah"
                size_hint_x: 0.28
                on_release: root.manager.current = "tambah"
        ScrollView:
            GridLayout:
                id: daftar_kegiatan
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: 6
                padding: [10, 10]
        Navigasi:

<TambahScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: [20, 15]
        spacing: 10
        BoxLayout:
            size_hint_y: None
            height: 60
            canvas.before:
                Color:
                    rgba: 0.13, 0.45, 0.36, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "Tambah Kegiatan"
                font_size: 22
                bold: True
                color: 1, 1, 1, 1
        Widget:
        Label:
            text: "Nama kegiatan"
            size_hint_y: None
            height: 26
            halign: "left"
            text_size: self.width, None
        TextInput:
            id: inp_nama
            multiline: False
            size_hint_y: None
            height: 46
            hint_text: "contoh: Baca Qur'an 1 halaman"
        Label:
            text: "Jam (format 24 jam, contoh: 06:30)"
            size_hint_y: None
            height: 26
            halign: "left"
            text_size: self.width, None
        TextInput:
            id: inp_jam
            multiline: False
            size_hint_y: None
            height: 46
            hint_text: "06:30"
        Label:
            text: "Hari"
            size_hint_y: None
            height: 26
        Spinner:
            id: spin_hari
            text: "Setiap hari"
            values: "Setiap hari,Senin,Selasa,Rabu,Kamis,Jumat,Sabtu,Ahad"
        Label:
            text: "Kategori"
            size_hint_y: None
            height: 26
        Spinner:
            id: spin_kategori
            text: "Ibadah"
            values: "Ibadah,Belajar,Lainnya"
        Label:
            id: lbl_pesan
            text: ""
            color: 0.85, 0.25, 0.25, 1
            size_hint_y: None
            height: 24
        Widget:
        BoxLayout:
            size_hint_y: None
            height: 52
            spacing: 10
            Button:
                text: "Batal"
                on_release: root.manager.current = "kegiatan"
            Button:
                text: "Simpan"
                on_release: root.simpan()

<TimerScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 30
        Label:
            text: "Timer Sesi Ibadah"
            font_size: 26
            bold: True
        Label:
            text: "Fitur ini menyusul di Minggu 3 :)"
            font_size: 16
        Widget:
        Navigasi:

<PengaturanScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 30
        Label:
            text: "Pengaturan"
            font_size: 26
            bold: True
        Label:
            text: "Pemilihan kota jadwal sholat menyusul di Minggu 2 :)"
            font_size: 16
        Widget:
        Navigasi: