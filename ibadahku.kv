<HomeScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: 120
            padding: [0, 10]
            canvas.before:
                Color:
                    rgba: 0.13, 0.45, 0.36, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "IbadahKu"
                font_size: 26
                bold: True
                color: 1, 1, 1, 1
            Label:
                text: root.tanggal
                font_size: 13
                color: 0.88, 0.96, 0.91, 1
            Label:
                text: root.countdown
                font_size: 17
                bold: True
                color: 1, 0.95, 0.8, 1
        ScrollView:
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                GridLayout:
                    id: timeline
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 6
                    padding: [10, 10]
                Widget:
                    size_hint_y: None
                    height: 16
                Label:
                    text: "Ceklis Ibadah Hari Ini"
                    font_size: 20
                    bold: True
                    size_hint_y: None
                    height: 32
                    color: 0.13, 0.35, 0.28, 1
                Label:
                    text: root.teks_streak
                    font_size: 14
                    size_hint_y: None
                    height: 24
                    color: 0.2, 0.45, 0.35, 1
                GridLayout:
                    id: grid_ceklis
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 6
                    padding: [10, 0]
                Button:
                    text: "+ Tambah Item Ceklis"
                    size_hint_y: None
                    height: 44
                    font_size: 14
                    background_color: 0.85, 0.93, 0.87, 1
                    color: 0.13, 0.35, 0.28, 1
                    on_release: root.buka_popup_ceklis()
                Widget:
                    size_hint_y: None
                    height: 14
        Navigasi:

<KegiatanScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: 60
            padding: [15, 8]
            spacing: 10
            canvas.before:
                Color:
                    rgba: 0.13, 0.45, 0.36, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "Kegiatanku"
                font_size: 22
                bold: True
                color: 1, 1, 1, 1
            Button:
                text: "+ Tambah"
                size_hint_x: 0.28
                on_release: root.manager.current = "tambah"
        ScrollView:
            GridLayout:
                id: daftar_kegiatan
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: 6
                padding: [10, 10]
        Navigasi:

<TambahScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: [20, 15]
        spacing: 10
        BoxLayout:
            size_hint_y: None
            height: 60
            canvas.before:
                Color:
                    rgba: 0.13, 0.45, 0.36, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "Tambah Kegiatan"
                font_size: 22
                bold: True
                color: 1, 1, 1, 1
        Widget:
        Label:
            text: "Nama kegiatan"
            size_hint_y: None
            height: 26
            halign: "left"
            text_size: self.width, None
        TextInput:
            id: inp_nama
            multiline: False
            size_hint_y: None
            height: 46
            hint_text: "contoh: Baca Qur'an 1 halaman"
        Label:
            text: "Jam (format 24 jam, contoh: 06:30)"
            size_hint_y: None
            height: 26
            halign: "left"
            text_size: self.width, None
        TextInput:
            id: inp_jam
            multiline: False
            size_hint_y: None
            height: 46
            hint_text: "06:30"
        Label:
            text: "Hari"
            size_hint_y: None
            height: 26
        Spinner:
            id: spin_hari
            text: "Setiap hari"
            values: "Setiap hari,Senin,Selasa,Rabu,Kamis,Jumat,Sabtu,Ahad"
        Label:
            text: "Kategori"
            size_hint_y: None
            height: 26
        Spinner:
            id: spin_kategori
            text: "Ibadah"
            values: "Ibadah,Belajar,Lainnya"
        Label:
            id: lbl_pesan
            text: ""
            color: 0.85, 0.25, 0.25, 1
            size_hint_y: None
            height: 24
        Widget:
        BoxLayout:
            size_hint_y: None
            height: 52
            spacing: 10
            Button:
                text: "Batal"
                on_release: root.manager.current = "kegiatan"
            Button:
                text: "Simpan"
                on_release: root.simpan()

<TimerScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: 60
            canvas.before:
                Color:
                    rgba: 0.13, 0.45, 0.36, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "Timer Sesi Ibadah"
                font_size: 22
                bold: True
                color: 1, 1, 1, 1
        Widget:
        Label:
            text: root.waktu
            font_size: 64
            bold: True
        ProgressBar:
            id: progres
            max: 1
            value: 0
            size_hint_y: None
            height: 18
        Widget:
        Label:
            text: "Durasi (menit)"
            size_hint_y: None
            height: 26
        Spinner:
            id: spin_durasi
            text: "15"
            values: "1,5,10,15,20,30,45,60"
            size_hint_y: None
            height: 48
        Widget:
        Label:
            text: root.status
            font_size: 15
            color: 0.2, 0.45, 0.35, 1
            size_hint_y: None
            height: 40
        BoxLayout:
            size_hint_y: None
            height: 52
            spacing: 10
            Button:
                text: "Mulai"
                on_release: root.mulai()
            Button:
                text: "Jeda"
                on_release: root.jeda()
            Button:
                text: "Ulang"
                on_release: root.ulang()
        Widget:
        Label:
            text: root.total_hari_ini
            font_size: 14
            color: 0.35, 0.35, 0.35, 1
            size_hint_y: None
            height: 30
        Widget:
        Navigasi:

<PengaturanScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: 60
            canvas.before:
                Color:
                    rgba: 0.13, 0.45, 0.36, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "Pengaturan"
                font_size: 22
                bold: True
                color: 1, 1, 1, 1
        Widget:
        Label:
            text: "Pilih kota untuk jadwal sholat:"
            size_hint_y: None
            height: 30
        Spinner:
            id: spin_kota
            text: "Jakarta"
            size_hint_y: None
            height: 48
        Label:
            text: "(kota lain bisa ditambah sendiri di DAFTAR_KOTA, main.py)"
            font_size: 12
            italic: True
            size_hint_y: None
            height: 28
            color: 0.4, 0.4, 0.4, 1
        Widget:
        Label:
            id: lbl_status
            text: ""
            color: 0.13, 0.45, 0.36, 1
            font_size: 14
        Widget:
        Button:
            text: "Simpan Kota"
            size_hint_y: None
            height: 52
            on_release: root.simpan_kota()
        Widget:
        Navigasi: